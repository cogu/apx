@startuml
skinparam backgroundColor transparent
skinparam shadowing false
skinparam defaultFontName sans-serif
skinparam activity {
  BackgroundColor #F7F8F6
  BorderColor #53616A
  DiamondBackgroundColor #E8EFEA
  DiamondBorderColor #53616A
  FontColor #172126
}
skinparam ArrowColor #3B4A54

start
fork
  :Client publishes <Node>.apx;
  :Server opens the definition file;
  :Client sends the complete definition;
  :Server validates and parses the definition;
  :Create port instances, byte offsets,\nserialization programs, and local buffers;
fork again
  if (Node has provide ports?) then (yes)
    :Client publishes <Node>.out;
  else (no)
  endif
end fork

if (Node has provide ports?) then (yes)
  :Server opens <Node>.out;
  :Client sends the complete initial\nprovide-data snapshot;
else (no)
endif

:Resolve provide and require connections;
:Populate local .cout, .cin, and .in buffers;\nBatch updates to already-open peer files;
:Server publishes eligible files in order:\n.cout, then .cin, then .in;
:Client requests count files before .in;
:Server sends a populated snapshot\nfor each opened file;

:Subsequent writes carry changed ranges;
stop
@enduml